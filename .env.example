# 이 파일을 .env.local 로 복사해서 값을 채운다. .env.local 은 공유 · 커밋하지 않는다
# Session pooler 등 postgres:// 접속 문자열은 쓰지 않는다 — 아래 3개만 사용
# 프로젝트 URL: 대시보드 Project Settings → Data API
SUPABASE_URL=https://xxxxxxxx.supabase.co
# 키: 대시보드 Project Settings → API Keys (Legacy 탭의 anon / service_role, 또는 publishable / secret)
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
